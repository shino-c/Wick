# Copy to .env and fill from your Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# "1" forces simulated biometrics even on a device that has a working camera.
# Leave unset for normal behaviour (real camera when available, simulation otherwise).
EXPO_PUBLIC_WICK_FORCE_SIMULATION=

# Your AI Model Key (Free tier models like google/gemini-2.0-flash-exp:free or meta-llama/llama-3.3-70b-instruct:free)
EXPO_PUBLIC_AI_API_KEY=your-key-here
